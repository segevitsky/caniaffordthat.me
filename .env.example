# Supabase — server-side only, read by api/* functions via process.env.
# SUPABASE_ANON_KEY is the publishable (sb_publishable_...) key; SERVICE_ROLE is the secret (sb_secret_...) key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only, used by api/parse tier 2 (AI-with-search link parsing).
# Optional: without it, api/parse runs tier 1 (OG/JSON-LD) only.
ANTHROPIC_API_KEY=

# Browser-safe vars only below this line. Never put a secret behind a VITE_ prefix.
VITE_GA_ID=
